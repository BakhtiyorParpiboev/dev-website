# Copy to .env.local and fill locally. Never commit real values.
PORT=5000
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ADMIN_EMAIL=
# Optional: the final published origin, without a trailing slash.
SITE_URL=
# Production: absolute path to a persistent upload volume.
UPLOAD_DIR=

# Set false when deployment storage is temporary (for example Render Free).
IMAGE_UPLOADS_ENABLED=true

# Optional: Resend email alerts for visitor messages. MESSAGE_EMAIL_FROM must
# be an address on a domain verified with Resend. Leave empty to disable alerts.
RESEND_API_KEY=
MESSAGE_EMAIL_FROM=
MESSAGE_EMAIL_TO=
