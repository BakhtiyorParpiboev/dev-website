{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bakhtiyor-portfolio-api.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://bakhtiyor-portfolio-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://bakhtiyor-portfolio-api.onrender.com/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "PORT=5173 BASE_PATH=/ VITE_IMAGE_UPLOADS_ENABLED=false pnpm run build",
  "outputDirectory": "dist/public"
}
