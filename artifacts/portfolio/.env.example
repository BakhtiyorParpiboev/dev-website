# Copy to .env.local. Only public browser configuration belongs here.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: configure only for a properly configured Clerk production proxy.
VITE_CLERK_PROXY_URL=
# Optional: the final published origin, without a trailing slash.
VITE_SITE_URL=

# Set false to offer HTTPS cover URLs instead of uploading files.
VITE_IMAGE_UPLOADS_ENABLED=true
